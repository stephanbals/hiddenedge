<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        HiddenEdge — AI Career Intelligence Platform
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {

            margin: 0;

            font-family:
                Arial,
                sans-serif;

            background:
                radial-gradient(
                    circle at top left,
                    #172554 0%,
                    #020617 45%
                ),
                #020617;

            color: white;

            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        /* =========================================
           BACKGROUND EFFECTS
        ========================================= */

        .glow {

            position: absolute;

            width: 500px;
            height: 500px;

            border-radius: 50%;

            background:
                rgba(99,102,241,0.12);

            filter: blur(120px);

            z-index: 0;
        }

        .glow.left {
            top: -120px;
            left: -120px;
        }

        .glow.right {
            bottom: -120px;
            right: -120px;
        }

        /* =========================================
           MAIN WRAPPER
        ========================================= */

        .wrapper {

            position: relative;

            z-index: 2;

            max-width: 1450px;

            margin: auto;

            padding:
                40px
                32px
                80px;
        }

        /* =========================================
           HERO
        ========================================= */

        .hero {

            display: grid;

            grid-template-columns:
                1.15fr
                0.85fr;

            gap: 50px;

            align-items: center;
        }

        /* =========================================
           LEFT HERO
        ========================================= */

        .hero-left {

            padding-top: 20px;
        }

        .brand {

            display: flex;

            align-items: center;

            gap: 14px;

            margin-bottom: 35px;
        }

        .brand img {

            width: 62px;

            filter:
                drop-shadow(
                    0 0 18px rgba(99,102,241,0.45)
                );
        }

        .brand h1 {

            margin: 0;

            font-size: 40px;

            font-weight: 700;
        }

        .tag {

            display: inline-block;

            margin-bottom: 24px;

            padding:
                10px
                16px;

            border-radius: 999px;

            background:
                rgba(59,130,246,0.12);

            border:
                1px solid rgba(59,130,246,0.22);

            color: #7dd3fc;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 1px;

            text-transform: uppercase;
        }

        .headline {

            font-size: 72px;

            line-height: 1.05;

            font-weight: 800;

            margin-bottom: 30px;

            max-width: 780px;
        }

        .headline span {

            background:
                linear-gradient(
                    135deg,
                    #8b5cf6,
                    #3b82f6
                );

            -webkit-background-clip: text;

            -webkit-text-fill-color: transparent;
        }

        .subtext {

            font-size: 24px;

            line-height: 1.7;

            color: #cbd5e1;

            max-width: 760px;

            margin-bottom: 42px;
        }

        .benefits {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 22px;

            margin-bottom: 55px;
        }

        .benefit {

            background:
                rgba(15,23,42,0.72);

            border:
                1px solid rgba(255,255,255,0.06);

            border-radius: 22px;

            padding: 22px;

            backdrop-filter: blur(14px);
        }

        .benefit h3 {

            margin-top: 0;

            margin-bottom: 10px;

            font-size: 20px;
        }

        .benefit p {

            margin: 0;

            color: #94a3b8;

            line-height: 1.6;

            font-size: 15px;
        }

        .robots {

            display: flex;

            justify-content: center;

            gap: 28px;

            margin-top: 10px;
        }

        .robots img {

            width: 170px;

            filter:
                drop-shadow(
                    0 0 30px rgba(59,130,246,0.28)
                );

            transition:
                transform 0.25s ease;
        }

        .robots img:hover {

            transform:
                translateY(-6px);
        }

        /* =========================================
           RIGHT HERO CARD
        ========================================= */

        .hero-card {

            background:
                linear-gradient(
                    180deg,
                    rgba(15,23,42,0.94),
                    rgba(2,6,23,0.96)
                );

            border:
                1px solid rgba(255,255,255,0.08);

            border-radius: 34px;

            padding: 42px;

            box-shadow:
                0 30px 80px rgba(0,0,0,0.38);

            backdrop-filter: blur(18px);
        }

        .hero-card h2 {

            margin-top: 0;

            font-size: 46px;

            line-height: 1.15;

            margin-bottom: 22px;
        }

        .hero-card h2 span {

            color: #8b5cf6;
        }

        .hero-card p {

            color: #cbd5e1;

            line-height: 1.8;

            font-size: 18px;
        }

        .checklist {

            margin-top: 30px;

            display: flex;

            flex-direction: column;

            gap: 16px;
        }

        .check {

            display: flex;

            align-items: center;

            gap: 14px;

            color: #e2e8f0;

            font-size: 17px;
        }

        .check-icon {

            width: 26px;
            height: 26px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #22c55e,
                    #16a34a
                );

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 14px;

            font-weight: bold;
        }

        .cta-btn {

            width: 100%;

            margin-top: 38px;

            padding:
                20px
                24px;

            border: none;

            border-radius: 18px;

            background:
                linear-gradient(
                    135deg,
                    #6366f1,
                    #9333ea
                );

            color: white;

            font-size: 22px;

            font-weight: bold;

            cursor: pointer;

            transition:
                transform 0.22s ease,
                box-shadow 0.22s ease;
        }

        .cta-btn:hover {

            transform:
                translateY(-2px);

            box-shadow:
                0 18px 40px rgba(99,102,241,0.34);
        }

        .trial {

            margin-top: 16px;

            text-align: center;

            color: #94a3b8;

            font-size: 14px;
        }

        .trust-box {

            margin-top: 34px;

            padding: 22px;

            border-radius: 18px;

            background:
                rgba(255,255,255,0.03);

            border:
                1px solid rgba(255,255,255,0.06);

            color: #cbd5e1;

            line-height: 1.7;
        }

        .coming {

            margin-top: 34px;
        }

        .coming h4 {

            margin-bottom: 18px;

            color: #8b5cf6;

            font-size: 18px;
        }

        .coming-grid {

            display: grid;

            grid-template-columns:
                1fr
                1fr;

            gap: 14px;
        }

        .coming-item {

            background:
                rgba(255,255,255,0.03);

            padding: 14px;

            border-radius: 14px;

            color: #cbd5e1;

            font-size: 14px;
        }

        .contact {

            margin-top: 40px;

            text-align: center;

            color: #94a3b8;

            font-size: 14px;
        }

        .contact a {

            color: #60a5fa;
        }

        /* =========================================
           COMPARISON SECTION
        ========================================= */

        .comparison {

            margin-top: 90px;

            display: grid;

            grid-template-columns:
                1fr
                1fr;

            gap: 30px;
        }

        .compare-card {

            background:
                rgba(15,23,42,0.72);

            border:
                1px solid rgba(255,255,255,0.06);

            border-radius: 28px;

            padding: 34px;
        }

        .compare-card h3 {

            margin-top: 0;

            font-size: 28px;
        }

        .bad {
            color: #f87171;
        }

        .good {
            color: #22c55e;
        }

        .compare-card ul {

            margin: 24px 0 0;

            padding-left: 20px;

            line-height: 2;

            color: #cbd5e1;
        }

        /* =========================================
           HOW IT WORKS
        ========================================= */

        .how {

            margin-top: 90px;

            text-align: center;
        }

        .how h2 {

            font-size: 52px;

            margin-bottom: 50px;
        }

        .steps-grid {

            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 24px;
        }

        .step {

            background:
                rgba(15,23,42,0.72);

            border:
                1px solid rgba(255,255,255,0.06);

            border-radius: 24px;

            padding: 26px;
        }

        .step-number {

            width: 44px;
            height: 44px;

            margin: auto auto 20px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #6366f1,
                    #9333ea
                );

            display: flex;

            align-items: center;
            justify-content: center;

            font-weight: bold;
        }

        .step h4 {

            margin-bottom: 12px;

            font-size: 20px;
        }

        .step p {

            color: #94a3b8;

            line-height: 1.7;

            font-size: 15px;
        }

        /* =========================================
           REGION SECTION
        ========================================= */

        .regions {

            margin-top: 90px;

            background:
                rgba(15,23,42,0.72);

            border:
                1px solid rgba(255,255,255,0.06);

            border-radius: 30px;

            padding: 40px;

            text-align: center;
        }

        .regions h2 {

            margin-top: 0;

            font-size: 40px;
        }

        .regions p {

            color: #cbd5e1;

            line-height: 1.8;

            max-width: 900px;

            margin:
                20px auto 40px;
        }

        .flags {

            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: 18px;
        }

        .flag {

            padding:
                14px
                20px;

            border-radius: 999px;

            background:
                rgba(255,255,255,0.04);

            border:
                1px solid rgba(255,255,255,0.08);

            color: #e2e8f0;
        }

        /* =========================================
           FOOTER
        ========================================= */

        footer {

            margin-top: 80px;

            text-align: center;

            color: #64748b;

            font-size: 14px;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 1200px) {

            .hero {
                grid-template-columns: 1fr;
            }

            .comparison {
                grid-template-columns: 1fr;
            }

            .steps-grid {
                grid-template-columns: 1fr;
            }

            .headline {
                font-size: 54px;
            }
        }

        @media (max-width: 768px) {

            .headline {
                font-size: 42px;
            }

            .subtext {
                font-size: 19px;
            }

            .benefits {
                grid-template-columns: 1fr;
            }

            .robots {
                flex-direction: column;
                align-items: center;
            }

            .robots img {
                width: 130px;
            }

            .hero-card h2 {
                font-size: 34px;
            }
        }

    </style>

</head>

<body>

<div class="glow left"></div>
<div class="glow right"></div>

<div class="wrapper">

    <!-- HERO -->

    <section class="hero">

        <!-- LEFT -->

        <div class="hero-left">

            <div class="brand">

                <img src="/static/Logo.png">

                <h1>
                    HiddenEdge
                </h1>

            </div>

            <div class="tag">
                AI Career Intelligence Platform
            </div>

            <div class="headline">

                The Market Isn’t
                Ignoring You.
                It’s <span>Misinterpreting You.</span>

            </div>

            <div class="subtext">

                HiddenEdge reveals how recruiters,
                ATS systems and hiring managers
                actually interpret your profile —
                so you can position your experience
                with clarity, relevance and impact.

            </div>

            <div class="benefits">

                <div class="benefit">

                    <h3>
                        Recruiter Intelligence
                    </h3>

                    <p>
                        Understand how recruiters
                        actually perceive your
                        experience and positioning.
                    </p>

                </div>

                <div class="benefit">

                    <h3>
                        ATS Alignment
                    </h3>

                    <p>
                        Identify hidden ATS gaps
                        before your application
                        gets filtered out.
                    </p>

                </div>

                <div class="benefit">

                    <h3>
                        Strategic Positioning
                    </h3>

                    <p>
                        Move beyond generic CV
                        writing and strengthen
                        your career narrative.
                    </p>

                </div>

                <div class="benefit">

                    <h3>
                        Better Outcomes
                    </h3>

                    <p>
                        Increase interview chances
                        through stronger role-fit
                        communication.
                    </p>

                </div>

            </div>

            <div class="robots">

                <img src="/static/alec.png">

                <img src="/static/helper.png">

                <img src="/static/nestor.png">

            </div>

        </div>

        <!-- RIGHT -->

        <div class="hero-card">

            <h2>

                See How Your Profile
                Is <span>Really Perceived</span>

            </h2>

            <p>

                Recruiter. ATS.
                Hiring Manager.

                <br><br>

                One intelligence-driven analysis.

            </p>

            <div class="checklist">

                <div class="check">

                    <div class="check-icon">
                        ✓
                    </div>

                    Instant AI-powered analysis

                </div>

                <div class="check">

                    <div class="check-icon">
                        ✓
                    </div>

                    Actionable career insights

                </div>

                <div class="check">

                    <div class="check-icon">
                        ✓
                    </div>

                    Discover hidden positioning gaps

                </div>

                <div class="check">

                    <div class="check-icon">
                        ✓
                    </div>

                    Improve recruiter interpretation

                </div>

                <div class="check">

                    <div class="check-icon">
                        ✓
                    </div>

                    Increase interview potential

                </div>

            </div>

            <button
                class="cta-btn"
                onclick="window.location.href='/eula'"
            >

                Start Free Analysis

            </button>

            <div class="trial">

                No credit card required •
                3 free analyses

            </div>

            <div class="trust-box">

                Built for professionals who want
                strategic positioning —
                not mass-produced generic
                CV rewriting.

                <br><br>

                Your data remains private
                and confidential.

            </div>

            <div class="coming">

                <h4>
                    Platform Expansion
                </h4>

                <div class="coming-grid">

                    <div class="coming-item">
                        CV Targeting Engine
                    </div>

                    <div class="coming-item">
                        Application Tracking
                    </div>

                    <div class="coming-item">
                        Interview Intelligence
                    </div>

                    <div class="coming-item">
                        Outcome Intelligence
                    </div>

                </div>

            </div>

            <div class="contact">

                Questions or feedback?

                <br><br>

                <a href="mailto:HiddenEdgeInfo@proton.me">
                    HiddenEdgeInfo@proton.me
                </a>

            </div>

        </div>

    </section>

    <!-- COMPARISON -->

    <section class="comparison">

        <div class="compare-card">

            <h3 class="bad">

                Traditional Job Search

            </h3>

            <ul>

                <li>
                    Your CV gets scanned in seconds
                </li>

                <li>
                    ATS filters remove candidates silently
                </li>

                <li>
                    Strong experience gets overlooked
                </li>

                <li>
                    Generic CV tools focus on cosmetics
                </li>

                <li>
                    You rarely know why you were rejected
                </li>

            </ul>

        </div>

        <div class="compare-card">

            <h3 class="good">

                The HiddenEdge Approach

            </h3>

            <ul>

                <li>
                    Understand how your profile is interpreted
                </li>

                <li>
                    Improve strategic positioning
                </li>

                <li>
                    Align with recruiter expectations
                </li>

                <li>
                    Communicate value more clearly
                </li>

                <li>
                    Increase interview opportunities
                </li>

            </ul>

        </div>

    </section>

    <!-- HOW IT WORKS -->

    <section class="how">

        <h2>
            How HiddenEdge Works
        </h2>

        <div class="steps-grid">

            <div class="step">

                <div class="step-number">
                    1
                </div>

                <h4>
                    Upload CV
                </h4>

                <p>
                    Upload your current CV
                    securely and privately.
                </p>

            </div>

            <div class="step">

                <div class="step-number">
                    2
                </div>

                <h4>
                    AI Analysis
                </h4>

                <p>
                    HiddenEdge evaluates recruiter,
                    ATS and hiring-manager alignment.
                </p>

            </div>

            <div class="step">

                <div class="step-number">
                    3
                </div>

                <h4>
                    Discover Gaps
                </h4>

                <p>
                    Reveal positioning weaknesses
                    and hidden opportunities.
                </p>

            </div>

            <div class="step">

                <div class="step-number">
                    4
                </div>

                <h4>
                    Improve Positioning
                </h4>

                <p>
                    Receive actionable guidance
                    to strengthen alignment.
                </p>

            </div>

            <div class="step">

                <div class="step-number">
                    5
                </div>

                <h4>
                    Advance Career
                </h4>

                <p>
                    Apply with greater clarity,
                    confidence and relevance.
                </p>

            </div>

        </div>

    </section>

    <!-- REGIONS -->

    <section class="regions">

        <h2>
            Optimized For Professional Roles
        </h2>

        <p>

            HiddenEdge currently delivers strongest
            opportunity discovery and matching coverage
            across Belgium, Netherlands, Germany
            and remote European opportunities.

            <br><br>

            Global expansion is in progress.

        </p>

        <div class="flags">

            <div class="flag">
                🇧🇪 Belgium
            </div>

            <div class="flag">
                🇳🇱 Netherlands
            </div>

            <div class="flag">
                🇩🇪 Germany
            </div>

            <div class="flag">
                🇪🇺 Remote Europe
            </div>

        </div>

    </section>

    <!-- FOOTER -->

    <footer>

        HiddenEdge © 2026

        <br><br>

        AI Career Intelligence Platform

    </footer>

</div>

<script>

const email =
    localStorage.getItem(
        "hiddenedge_email"
    );

if (email) {

    window.location.href = "/app";
}

</script>

</body>
</html>